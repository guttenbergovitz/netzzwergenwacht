{
  "benchmark_name": "Zwergenprüfstand",
  "version": "0.1.0",
  "pages": [
    {
      "path": "/healthy.html",
      "role": "healthy_control",
      "expected_defects": []
    },
    {
      "path": "/perf-and-structure.html",
      "role": "landing_page_with_defects",
      "expected_defects": [
        { "rule_id": "a11y.images.alt", "domain": "accessibility" },
        { "rule_id": "str.doc.duplicate_ids", "domain": "semantics" },
        { "rule_id": "str.headings.hierarchy", "domain": "semantics" },
        { "rule_id": "such.meta.description", "domain": "seo" }
      ]
    },
    {
      "path": "/a11y.html",
      "role": "form_page_with_defects",
      "expected_defects": [
        { "rule_id": "a11y.doc.lang", "domain": "accessibility" },
        { "rule_id": "a11y.images.alt", "domain": "accessibility" },
        { "rule_id": "a11y.forms.labels", "domain": "accessibility" },
        { "rule_id": "a11y.aria.broken_references", "domain": "accessibility" }
      ]
    },
    {
      "path": "/multilingual-defective.html",
      "role": "multilingual_with_defects",
      "expected_defects": [
        { "rule_id": "such.i18n.missing_self_reference", "domain": "seo" },
        { "rule_id": "inh.integrity.unresolved_translation_key", "domain": "content" },
        { "rule_id": "inh.integrity.placeholder_contact", "domain": "content" }
      ]
    },
    {
      "path": "/spa-shell.html",
      "role": "spa_client_shell",
      "expected_defects": [
        { "rule_id": "inh.content.thin_content", "domain": "content" }
      ]
    },
    {
      "path": "/ecommerce-product.html",
      "role": "ecommerce_with_defects",
      "expected_defects": [
        { "rule_id": "such.schema.json_ld", "domain": "seo" },
        { "rule_id": "a11y.forms.labels", "domain": "accessibility" }
      ]
    }
  ],
  "expected_systemic_rules": ["a11y.images.alt", "such.meta.description"],
  "remediation_variants": [
    {
      "baseline": "/a11y.html",
      "fixed": "/fixed/a11y.html",
      "expected_resolved": [
        "a11y.doc.lang",
        "a11y.images.alt",
        "a11y.forms.labels",
        "a11y.aria.broken_references"
      ]
    }
  ]
}
